# =============================================================================
# Enterprise ERP: environment template
#
#   cp .env.template .env      (or run: make init, which also generates secrets)
#
# Every value below is a placeholder. NEVER commit the resulting .env, it is
# blocked by .gitignore and by the pre-commit hook.
#
# Generate a secret:   openssl rand -hex 32
#
# Full reference, including which service reads each variable:  ENV_SETUP.md
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=5000

# Host port the Nginx edge proxy is published on.
EDGE_PORT=8080

# Tag applied to locally built images.
IMAGE_TAG=local

# -----------------------------------------------------------------------------
# Public URLs
#
# With the default compose setup everything is served through Nginx on one
# origin, so these all point at the same place.
# -----------------------------------------------------------------------------
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:8080

# -----------------------------------------------------------------------------
# Database
#
# docker-compose.yml overrides MONGO_URI to point at the internal `mongo`
# service. Set it here only when running outside Docker.
#
# The replica set is REQUIRED, not optional: the application uses multi-document
# transactions, which a standalone mongod cannot serve.
# -----------------------------------------------------------------------------
MONGO_DB=erp_platform
# MONGO_URI=mongodb://localhost:27017/erp_platform?replicaSet=rs0

# -----------------------------------------------------------------------------
# Cache / session store
#
# REDIS_HOST and REDIS_PORT are set by compose. The password is consumed both by
# the API and by the redis container's --requirepass flag.
# -----------------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_GENERATE_A_RANDOM_STRING
REDIS_TLS=false
# REDIS_HOST=localhost
# REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Authentication
#
# REQUIRED. The service refuses to start if these are unset or shorter than 32
# characters. There is deliberately no built-in default.
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_REFRESH_SECRET=CHANGE_ME_openssl_rand_hex_32

# -----------------------------------------------------------------------------
# Platform admin seed  (used by: npm run seed:admin)
#
# ADMIN_PASSWORD is required by the seeder and must be at least 12 characters.
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Platform Administrator
ADMIN_PASSWORD=CHANGE_ME_MIN_12_CHARS

# -----------------------------------------------------------------------------
# Object storage
#
# REQUIRED for the API to boot: the storage module validates these at import.
# For a local run without a real bucket, placeholder values let the service
# start; file uploads will then fail at call time.
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
S3_BUCKET=CHANGE_ME

# Local staging directory for uploads before they reach object storage.
# Defaults to <working directory>/uploads. The Docker image sets it to
# /app/uploads, where the named volume is mounted and the service user owns it.
# UPLOAD_DIR=

# -----------------------------------------------------------------------------
# CDN signed URLs  (optional: leave blank to serve without signing)
#
# CLOUDFRONT_PRIVATE_KEY_BASE64 holds a PEM private key with literal \n escapes
# in place of newlines. Treat it with the same care as a password.
# -----------------------------------------------------------------------------
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY_BASE64=
URL_SIGNING_EXPIRES_SECONDS=300

# -----------------------------------------------------------------------------
# Email
#
# Leave SMTP_HOST blank to use the Gmail service preset. Gmail requires an App
# Password, not the account password.
# -----------------------------------------------------------------------------
SMTP_USER=
SMTP_PASS=
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false

# -----------------------------------------------------------------------------
# Billing  (optional: the billing module is inactive without it)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=

# -----------------------------------------------------------------------------
# Frontend build arguments
#
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time and are
# therefore public by definition. Never put a secret here.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CDN_HOSTNAME=
NEXT_PUBLIC_EXTRA_IMAGE_HOSTS=

# -----------------------------------------------------------------------------
# Audit log sink  (optional)
#
# CLICKHOUSE_URL is the on/off switch. Left blank, every audit write is a no-op
# and the API runs normally. No clickhouse service ships in docker-compose.yml,
# so set this only when you have a sink to point at.
# -----------------------------------------------------------------------------
# CLICKHOUSE_URL=
# CLICKHOUSE_USER=
# CLICKHOUSE_PASSWORD=
# AUDIT_DB=default
# AUDIT_TABLE=audit_events
