# =============================================================================
# Whitespace and line-ending rules for the client and server codebases.
# https://editorconfig.org
#
# LF everywhere matters here: the images are Alpine Linux, and a CRLF shebang
# or shell script fails inside a container with a confusing "not found" error.
# =============================================================================

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

# --- Source ------------------------------------------------------------------
[*.{js,jsx,ts,tsx,mjs,cjs}]
indent_size = 2
quote_type = double

[*.{json,jsonc,json5}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2
# YAML has no line continuation for indented scalars; folding is done by hand.
max_line_length = off

[*.{css,scss,less}]
indent_size = 2

# --- Documentation -----------------------------------------------------------
[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false
max_line_length = off

# --- Tooling -----------------------------------------------------------------
# Make is whitespace-significant: recipe lines must begin with a real tab.
[Makefile]
indent_style = tab
indent_size = 4

[{Dockerfile,Dockerfile.*,*.dockerfile}]
indent_size = 4

[*.{sh,bash}]
indent_size = 2
# Shell scripts are executed by the container entrypoint; CRLF breaks them.
end_of_line = lf

[*.conf]
indent_size = 4

# --- Generated ---------------------------------------------------------------
[{package-lock.json,npm-shrinkwrap.json,yarn.lock,pnpm-lock.yaml}]
indent_style = space
indent_size = 2
insert_final_newline = false
trim_trailing_whitespace = false
