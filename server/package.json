{
  "name": "erp-platform-server",
  "version": "1.0.0",
  "description": "Enterprise ERP: API service",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.19.0 <21",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/index.ts",
    "build": "tsup src/index.ts src/database/seeders/seedAdmin.ts src/database/seeders/seedContractTypes.ts src/tools/generateSwagger.ts --out-dir dist --format cjs --clean && npm run build:swagger",
    "build:swagger": "node dist/tools/generateSwagger.js",
    "start": "node dist/index.js",
    "test": "jest --passWithNoTests",
    "test:ci": "jest --ci --passWithNoTests --reporters=default --detectOpenHandles --verbose",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "seed:contract-types": "ts-node -r tsconfig-paths/register src/database/seeders/seedContractTypes.ts",
    "seed:admin": "ts-node -r tsconfig-paths/register src/database/seeders/seedAdmin.ts",
    "db:reset": "node dropAllCollections.js"
  },
  "author": "",
  "license": "ISC",
  "keywords": [],
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.13",
    "@types/node": "^24.0.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/winston": "^2.4.4",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.0"
  },
  "dependencies": {
    "@aws-sdk/cloudfront-signer": "^3.873.0",
    "@clickhouse/client": "^1.12.1",
    "@types/pdfkit": "^0.17.3",
    "aws-sdk": "^2.1692.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "mongoose": "^8.15.1",
    "multer": "^2.0.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.5",
    "pdfkit": "^0.17.2",
    "stripe": "^18.2.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^8.5.0",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "zod": "^3.25.61"
  }
}
